# TAHMISCI production environment template
# Copy this file OUTSIDE the repository (for example
# /etc/tahmisci/tahmisci.env), replace every REPLACE_* value and chmod 600.
# Never commit the populated environment file.

# Runtime
NODE_ENV=production
PORT=8080

# Public origins and host routing
MAIN_DOMAIN=tahmiscicoffee.com
ADMIN_DOMAIN=tahmiscicoffee.com
PUBLIC_SITE_URL=https://tahmiscicoffee.com
ALLOWED_ORIGINS=https://tahmiscicoffee.com,https://www.tahmiscicoffee.com

# Authentication and encrypted password storage
# Generate independently, for example with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=tahmisci-backend
JWT_AUDIENCE=tahmisci-admin
PASSWORD_MANAGER_KEY=REPLACE_WITH_DIFFERENT_RANDOM_KEY_AT_LEAST_32_CHARS
ADMIN_COOKIE_NAME=tahmisci_admin_session
RECIPE_COOKIE_NAME=tahmisci_recipe_session
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
ALLOW_LOCALHOST_ORIGINS=false
# One trusted local Nginx hop. Do not use true in production.
TRUST_PROXY=1

# Request limits; Excel import and media endpoints also enforce route limits.
API_JSON_LIMIT_KB=1024
API_URLENCODED_LIMIT_KB=64

# Persistent data, deliberately outside the application checkout
DATA_FILE=/var/lib/tahmisci/store/store.json
MEDIA_DIR=/var/lib/tahmisci/media
# Private invoice/evidence storage. This directory must never be mounted by
# Express/Nginx as a public static path.
PROCUREMENT_DOCUMENTS_DIR=/var/lib/tahmisci/procurement-documents
PROCUREMENT_MAX_UPLOAD_BYTES=10485760
BACKUP_DIR=/var/backups/tahmisci

# First-install credentials. Leave empty for an existing migrated store.
# If needed for a new empty store, inject one-time strong values at deploy time,
# sign in, rotate them immediately, then remove them from the environment.
DEFAULT_PANEL_PASSWORD=
DEFAULT_RECIPE_PASSWORD=
BCRYPT_ROUNDS=12

# Password reset and SMTP. PASSWORD_RESET_EMAIL is an optional emergency
# recovery recipient for the admin account only; it is never a personnel
# verification or password-reset recipient.
PASSWORD_RESET_EMAIL=
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# SMTP_USER/SMTP_FROM are senders. Personnel mail is delivered only to the
# verified email stored on that personnel account.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tahmisçi <no-reply@tahmiscicoffee.com>"

# Notification delivery. In-app notifications work without SMTP or VAPID.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_MANAGER_EMAIL=
# VAPID_PRIVATE_KEY is server-only. Generate the key pair securely and never
# expose or commit the private key.
VAPID_SUBJECT=mailto:notifications@tahmiscicoffee.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NOTIFICATION_WORKERS_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000
NOTIFICATION_REMINDER_INTERVAL_MS=60000
NOTIFICATION_MAX_ATTEMPTS=5
