# Safe environment template. For production copy .env.production.example
# to an external protected location; never commit the populated file.
NODE_ENV=production
PORT=8080

MAIN_DOMAIN=tahmiscicoffee.com
ADMIN_DOMAIN=tahmiscicoffee.com
PUBLIC_SITE_URL=https://tahmiscicoffee.com
ALLOWED_ORIGINS=https://tahmiscicoffee.com,https://www.tahmiscicoffee.com

JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=tahmisci-backend
JWT_AUDIENCE=tahmisci-admin
PASSWORD_MANAGER_KEY=REPLACE_WITH_DIFFERENT_RANDOM_KEY_AT_LEAST_32_CHARS
ADMIN_COOKIE_NAME=tahmisci_admin_session
RECIPE_COOKIE_NAME=tahmisci_recipe_session
MUDAVIM_COOKIE_NAME=tahmisci_mudavim_session
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
ALLOW_LOCALHOST_ORIGINS=false
TRUST_PROXY=1
API_JSON_LIMIT_KB=1024
API_URLENCODED_LIMIT_KB=64

DATA_FILE=/var/lib/tahmisci/store/store.json
MEDIA_DIR=/var/lib/tahmisci/media
PROCUREMENT_DOCUMENTS_DIR=/var/lib/tahmisci/procurement-documents
PROCUREMENT_MAX_UPLOAD_BYTES=10485760
BACKUP_DIR=/var/backups/tahmisci

DEFAULT_PANEL_PASSWORD=
DEFAULT_RECIPE_PASSWORD=
BCRYPT_ROUNDS=12

# Optional emergency recovery recipient for the admin account only.
# It is never used as a personnel verification or password-reset recipient.
PASSWORD_RESET_EMAIL=
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# Yönetici, Personel ve internal notification e-postaları
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tahmisçi <info@tahmiscicoffee.com>"

# Müdavim kayıt, hesap ve notification e-postaları
MUDAVIM_SMTP_HOST=
MUDAVIM_SMTP_PORT=465
MUDAVIM_SMTP_SECURE=true
MUDAVIM_SMTP_USER=
MUDAVIM_SMTP_PASS=
MUDAVIM_SMTP_FROM="Tahmisçi Müdavim <mudavim@tahmiscicoffee.com>"

NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_MANAGER_EMAIL=
# VAPID_PRIVATE_KEY is server-only. Generate the key pair securely and never
# expose or commit the private key.
VAPID_SUBJECT=mailto:notifications@tahmiscicoffee.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NOTIFICATION_WORKERS_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000
NOTIFICATION_REMINDER_INTERVAL_MS=60000
NOTIFICATION_MAX_ATTEMPTS=5
